# ============================================
# TRUST SCORE MVP — ENVIRONMENT VARIABLES
# ============================================
# Copy this file to ".env" (same folder) and fill in your real keys.
# Never commit the real ".env" file to GitHub — it's already in .gitignore.

# --- GitHub Personal Access Token ---
# Needed to call the GitHub API at higher rate limits (5,000 req/hour vs 60/hour unauthenticated)
# and to read repo/commit data.
# How to get one (free, 2 minutes):
#   1. Go to https://github.com/settings/tokens
#   2. Click "Generate new token" -> "Generate new token (classic)"
#   3. Name it "trust-score-mvp", set expiration (90 days is fine for dev)
#   4. Scopes needed: "public_repo" (read-only access to public repos) — that's it, no other scopes needed
#   5. Generate, then paste the token below (starts with "ghp_")
GITHUB_TOKEN=ghp_your_token_here

# --- Groq API Key ---
# Free tier, no credit card required.
# How to get one (free, 1 minute):
#   1. Go to https://console.groq.com
#   2. Sign up with email or Google
#   3. Go to "API Keys" in the left sidebar -> "Create API Key"
#   4. Paste it below (starts with "gsk_")
GROQ_API_KEY=gsk_your_key_here

# --- Database (Postgres) ---
# Render's free web services wipe local files on every redeploy, so we use a
# hosted Postgres database instead of SQLite — this actually persists.
# Using Supabase here — go to Project Settings -> Database -> Connection string
# (use the "Connection pooling" URI for best compatibility), paste it below.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Server config ---
PORT=3001